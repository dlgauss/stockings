# Copy to .env and fill in. .env is gitignored; this file is the template.

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# True only on your machine. Leave False (or unset) on the server.
DEBUG=False

# Comma-separated domain names the site is served on.
ALLOWED_HOSTS=example.md,www.example.md

# Comma-separated full origins, needed for the order form over HTTPS.
CSRF_TRUSTED_ORIGINS=https://example.md,https://www.example.md

# Optional. Defaults to SQLite at db/db.sqlite3.
# DATABASE_URL=postgres://user:password@localhost:5432/cashmere
